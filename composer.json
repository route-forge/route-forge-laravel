{
    "name": "route-forge/laravel",
    "description": "Laravel named routes for SPA frontends: per-tier lazy loading via an HTTP metadata endpoint, an auto-discovery summary, TypeScript type generation, and zero-annotation route export. Backend of the route-forge project.",
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/route-forge/route-forge-laravel",
    "authors": [
        {
            "name": "阿杰很厉害",
            "email": "506907958@qq.com",
            "homepage": "https://github.com/xyj2156"
        }
    ],
    "support": {
        "issues": "https://github.com/route-forge/route-forge-laravel/issues",
        "source": "https://github.com/route-forge/route-forge-laravel",
        "docs": "https://github.com/route-forge/route-forge-laravel/tree/main/.docs"
    },
    "keywords": [
        "laravel",
        "route",
        "routes",
        "routing",
        "named-route",
        "spa",
        "tier",
        "tiered-routing",
        "lazy-loading",
        "on-demand",
        "metadata",
        "typescript",
        "types",
        "api",
        "vue",
        "react",
        "inertia",
        "frontend",
        "single-source-of-truth",
        "php"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/cache": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5 || ^13.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "RouteForge\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RouteForge\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test:coverage": "phpunit --coverage-text"
    },
    "extra": {
        "laravel": {
            "providers": [
                "RouteForge\\Laravel\\ForgeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
